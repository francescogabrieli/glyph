glyph/0.2
agent backend
goal backend maintain_improve security
stack[docker,fastapi,mypy,postgres,pytest,python,ruff]
scope[migrations/,src/,tests/]
flow[read,plan,minimal_change,lint,typecheck,test,report]
cmd.dev "uvicorn app.main:app --reload"
cmd.install "pip install -e \".[dev]\""
cmd.lint "ruff check ."
cmd.migrate "alembic upgrade head"
cmd.test "pytest"
cmd.typecheck "mypy src"
must[document_breaking_changes,explain_unrun_tests,follow_existing_style,keep_pr_focused,lint_before_done,minimal_change,plan_before_edit,prefer_existing_patterns,read_before_edit,report_changes,report_verification,run_tests_before_done,simple_explicit_code,small_reviewable_changes,typecheck_before_done,update_docs_when_behavior_changes,use_existing_helpers,validate_database_migrations,verify_build_before_done]
deny[api_key_exposure,avoid_dependency_changes_without_reason,avoid_generated_files,avoid_large_dependency_additions,avoid_raw_database_connections,avoid_touching_secrets_or_env_files,avoid_unrelated_packages,credentials_exposure,deploy_without_approval,do_not_commit_debug_logs,do_not_edit_lockfiles_unless_needed,do_not_modify_ci_without_reason,no_large_refactors,prod_config_write,secrets_commit,unsafe_migrations]
ask[destructive_ops,schema_changes]
