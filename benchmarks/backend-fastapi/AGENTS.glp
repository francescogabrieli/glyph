policy[must p_72bbf0b8351a expression="{\"kind\":\"action\",\"objects\":[\"the_development_server\"],\"op\":\"atomic\",\"predicate\":\"run\",\"subject\":[\"agent\"]}" risk=low]
policy[must p_930651aabc3a expression="{\"op\":\"all\",\"operands\":[{\"kind\":\"action\",\"objects\":[\"reviewable\"],\"op\":\"atomic\",\"predicate\":\"keep\",\"subject\":[\"agent\"]},{\"kind\":\"action\",\"objects\":[\"migrations_linear\"],\"op\":\"atomic\",\"predicate\":\"keep\",\"subject\":[\"agent\"]}]}" risk=high tag=database]
preserve[must x_608035a9ce93 risk=low tag=repository -- "The resolver rule is specific to this benchmark repository and should remain visible to inspect if it is not registered as a core semantic unit."]
preserve[must x_e57234999fbf risk=medium tag=repository tag=testing -- "Services own business decisions, repositories own persistence details, and tests should verify behavior near the boundary being changed."]
